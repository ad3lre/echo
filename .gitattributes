# Normalize text line endings for consistent Prettier + CI (Linux).
* text=auto eol=lf

# Binary / non-text — do not convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.zip binary
*.safetensors binary
