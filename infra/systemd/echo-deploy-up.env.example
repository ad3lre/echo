# Copy to: $ECHO_DEPLOY_ROOT/systemd.env
# (e.g. /opt/echo-deploy/systemd.env)
# Use a single Node/npm on PATH for systemd.
PATH=/opt/node/bin:/usr/bin:/bin

ECHO_DEPLOY_ROOT=/opt/echo-deploy
ECHO_DEPLOY_RELEASE_BLUE=/opt/echo-blue
ECHO_DEPLOY_RELEASE_GREEN=/opt/echo-green

# Stable path for Caddy SPA root → echo-deploy updates this symlink on each cutover:
#   root * /opt/echo-active/frontend/dist
ECHO_DEPLOY_PUBLIC_ROOT_SYMLINK=/opt/echo-active

# If `git pull` from systemd fails (no ssh-agent), use a read-only deploy key (no passphrase)
# or set GIT_SSH_COMMAND to a dedicated key:
# GIT_SSH_COMMAND=ssh -i /etc/echo/deploy_key -o IdentitiesOnly=yes

# If Caddy reload needs explicit config (non-default):
# ECHO_DEPLOY_PROXY_RELOAD=/usr/bin/sudo /usr/bin/systemctl reload caddy
