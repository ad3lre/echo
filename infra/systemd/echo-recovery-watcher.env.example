# Copy to /etc/echo/recovery-watcher.env (root:echo, chmod 640).
# PATH must include the Node binary from .nvmrc (see echo-deploy-up.env.example).

ECHO_REPO_ROOT=/opt/echo
ECHO_RECOVERY_WATCHER_ENABLED=1

# 45 minutes before force-restart (milliseconds).
# ECHO_RECOVERY_WATCHER_DOWN_MS=2700000

# Poll interval while watching (milliseconds).
# ECHO_RECOVERY_WATCHER_POLL_MS=30000

# Failure notification (recovery still down after restart attempt).
ECHO_RECOVERY_WATCHER_FAILURE_EMAIL=bugs@chat-echo.com

# Local health probe (default :3000 API).
# ECHO_WATCHDOG_LOCAL_HEALTH_URL=http://127.0.0.1:3000/api/v1/health

# SMTP — same vars as the main Echo app (.env); can duplicate here or symlink.
# ECHO_SMTP_HOST=
# ECHO_SMTP_PORT=587
# ECHO_SMTP_SECURE=false
# ECHO_SMTP_USER=
# ECHO_SMTP_PASSWORD=
# ECHO_EMAIL_FROM=Echo <noreply@chat-echo.com>

# Example PATH when using nvm Node 22:
# PATH=/home/echo/.nvm/versions/node/v22.13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
