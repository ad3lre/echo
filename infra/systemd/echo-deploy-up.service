# Blue-green production deploy: pull+build idle slot, health check, Caddy cutover.
# Install: copy to /etc/systemd/system/ and `systemctl daemon-reload`.
# One-time: copy infra/systemd/echo-deploy-up.env.example to
#   $ECHO_DEPLOY_ROOT/systemd.env (e.g. /opt/echo-deploy/systemd.env)
# and set PATH to the Node/npm that should run in systemd (often ~/.nvm/.../bin).

[Unit]
Description=Echo blue-green deploy (idle build, health, Caddy flip)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=echo
Group=echo

# Optional env file (recommended): ECHO_DEPLOY_*, PATH for Node/npm, GIT_SSH_COMMAND if needed.
EnvironmentFile=-/opt/echo-deploy/systemd.env

WorkingDirectory=/opt/echo-blue

# Uses npm from PATH (EnvironmentFile) so Node matches production toolchain (nvm, fnm, etc.).
ExecStart=/usr/bin/env npm run deploy:up

# Builds + npm ci can take a while on cold cache.
TimeoutStartSec=3600

Nice=5

[Install]
WantedBy=multi-user.target
