# Paste inside your site block (e.g. `chat-echo.com { ... }`) **after** any `handle /api/*` and
# `handle /socket.io*` routes so JSON and Engine.IO responses still use Helmet only, while HTML
# and static assets get CSP + HSTS here (Mozilla HTTP Observatory grades `GET /`).
#
# On VPS hosts using `npm run vps:prod`, paste this into your site block after the
# `/api/*` and `/socket.io*` reverse_proxy handles. Adjust `root` to your checkout's
# `frontend/dist` path (or proxy SPA traffic to `127.0.0.1:4173` instead).

route {
	# iOS Universal Links — must be JSON, not SPA index.html (Apple rejects HTML fallbacks).
	@aasa path /.well-known/apple-app-site-association /apple-app-site-association
	handle @aasa {
		root * /srv/echo/frontend/dist
		header Content-Type application/json
		file_server
	}

	# Never expose deployment manifest files copied into dist for Pages/Netlify.
	@deployManifests path /_headers /_redirects
	handle @deployManifests {
		respond 404
	}

	# Defense-in-depth: never serve source maps from the static root (CI also rejects *.map in dist).
	@sourceMaps path_regexp \.map$
	handle @sourceMaps {
		respond 404
	}

	handle {
		root * /srv/echo/frontend/dist
		encode zstd gzip
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self' https://challenges.cloudflare.com https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://openguessr.com https://skribbl.io https://garticphone.com https://www.garticphone.com https://krunker.io https://codenames.game https://richup.io https://gooberdash.winterpixel.io https://smashkarts.io https://www.y8.com https://clusterrush.io; upgrade-insecure-requests"
		}
		@hashedAssets path /assets/*
		header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
		@html path /
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed br gzip
		}
	}
}
