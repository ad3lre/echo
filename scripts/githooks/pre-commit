#!/usr/bin/env bash
# Fail commits that grow baselined god files or introduce new ones without a baseline entry.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

if [[ -n "${ECHO_GOD_FILE_RATCHET_BYPASS:-}" ]]; then
  exit 0
fi

node "$ROOT/scripts/check-god-file-ratchet.mjs" --staged
