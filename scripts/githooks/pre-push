#!/usr/bin/env bash
# Validate pushes to github.com (never create/update main there).
# Mirror release/1.0.0 to GitHub only when ECHO_RELEASE_MIRROR_NOW=1; otherwise the
# daily cron (23:00, see install-release-mirror-cron.sh) batches all GitLab pushes.
#
# See docs/operations/github-release-mirror.md.
set -euo pipefail

push_url="${2:-}"
zero=0000000000000000000000000000000000000000
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
MIRROR_HOUR="${ECHO_RELEASE_MIRROR_HOUR:-23}"
MIRROR_TZ="${ECHO_RELEASE_MIRROR_TZ:-Europe/Berlin}"

ref_updates=$(cat || true)

if [[ "$push_url" == *github.com* ]]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    if [[ "$remote_ref" == "refs/heads/main" && "$local_sha" != "$zero" ]]; then
      echo "pre-push: refusing to push or update branch 'main' on GitHub (mirror is release/1.0.0 only)." >&2
      echo "  To remove a mistaken main: git push github --delete main" >&2
      exit 1
    fi
  done <<<"$ref_updates"
  exit 0
fi

release_pushed=0
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  if [[ "$remote_ref" == "refs/heads/release/1.0.0" ]]; then
    release_pushed=1
  fi
done <<<"$ref_updates"

if [[ "$release_pushed" -eq 0 ]]; then
  exit 0
fi

if [[ -n "${ECHO_RELEASE_MIRROR_NOW:-}" ]]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    [[ "$local_sha" == "$zero" ]] && continue
    [[ "$remote_ref" != "refs/heads/release/1.0.0" ]] && continue
    bash "$ROOT/scripts/mirror-release-to-github.sh" "$local_sha"
  done <<<"$ref_updates"
  exit 0
fi

printf 'pre-push: GitHub mirror deferred until %s:00 %s (batched once per day).\n' \
  "$MIRROR_HOUR" "$MIRROR_TZ" >&2
printf '  GitLab push will continue. To mirror immediately: ECHO_RELEASE_MIRROR_NOW=1 git push …\n' >&2
printf '  Or: npm run mirror:github-release\n' >&2
printf '  Install cron: npm run mirror:github-release:install-cron -- --yes\n' >&2
exit 0
