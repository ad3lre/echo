#!/usr/bin/env bash
# When pushing refs/heads/release/1.0.0 to a non-GitHub remote (e.g. GitLab origin),
# mirror that same ref to the remote named "github" (https://github.com/ad3lre/echo).
# Pushes whose URL is already github.com: validate refs (never create/update main there),
# then exit without mirroring (avoids double work).
#
# GitHub is release-only: never create or update refs/heads/main there (see
# docs/operations/github-release-mirror.md). Deletes of remote main are allowed.
#
# Also refuse mirroring when release/1.0.0 would point at the same commit as
# origin/main (fast-forward to main): that publishes GitLab's per-commit graph
# on the public default branch. Use squash sync (see doc) unless overridden.
set -euo pipefail

push_url="${2:-}"
zero=0000000000000000000000000000000000000000

# Git pre-push supplies ref updates on stdin; read once so we can branch on remote URL.
ref_updates=$(cat || true)

if [[ "$push_url" == *github.com* ]]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    if [[ "$remote_ref" == "refs/heads/main" && "$local_sha" != "$zero" ]]; then
      echo "pre-push: refusing to push or update branch 'main' on GitHub (mirror is release/1.0.0 only)." >&2
      echo "  To remove a mistaken main: git push github --delete main" >&2
      exit 1
    fi
  done <<<"$ref_updates"
  exit 0
fi

if ! git remote get-url github &>/dev/null; then
    echo "pre-push: remote 'github' is missing. Add it once, then retry:" >&2
    echo "  git remote add github https://github.com/ad3lre/echo.git" >&2
    exit 1
fi

# So --force-with-lease can compare against the last mirrored tip.
git fetch github refs/heads/release/1.0.0:refs/remotes/github/release/1.0.0 --quiet 2>/dev/null || true

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  if [[ "$remote_ref" != "refs/heads/release/1.0.0" ]]; then
    continue
  fi
  if [[ -z "${ECHO_RELEASE_MIRROR_ALLOW_MAIN_TIP:-}" ]] && git remote get-url origin &>/dev/null; then
    git fetch origin refs/heads/main:refs/remotes/origin/main --quiet 2>/dev/null || true
    origin_main=$(git rev-parse origin/main 2>/dev/null || true)
    if [[ -n "$origin_main" && "$local_sha" == "$origin_main" ]]; then
      echo "pre-push: refusing to mirror release/1.0.0: tip matches origin/main." >&2
      echo "  That exposes GitLab main's commit-by-commit history on GitHub (same tip SHA)." >&2
      echo "  Use a squash sync instead — see docs/operations/github-release-mirror.md" >&2
      echo "  Emergency override: ECHO_RELEASE_MIRROR_ALLOW_MAIN_TIP=1 git push ..." >&2
      exit 1
    fi
  fi

  echo "pre-push: mirroring release/1.0.0 to github (ad3lre/echo)..."
  prev=$(git rev-parse github/release/1.0.0 2>/dev/null || true)
  if [[ -n "$prev" ]]; then
    git push github "${local_sha}:refs/heads/release/1.0.0" --force-with-lease=refs/heads/release/1.0.0:"$prev"
  else
    git push github "${local_sha}:refs/heads/release/1.0.0"
  fi
done <<<"$ref_updates"
