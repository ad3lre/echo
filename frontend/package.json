{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Frontend for the Echo private communication platform.",
  "scripts": {
    "dev": "vite",
    "dev:low-mem": "cross-env ECHO_VITE_LOW_MEM=1 vite",
    "dev:e2e": "vite --port 8080 --strictPort",
    "prebuild": "node ../scripts/generate-pwa-icons.mjs && node ../scripts/copy-oauth-bridge-fonts.mjs",
    "build": "vue-tsc && vite build",
    "build:no-typecheck": "node ../scripts/generate-pwa-icons.mjs && node ../scripts/copy-oauth-bridge-fonts.mjs && vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "lint": "cross-env ESLINT_STRICT=1 eslint src --quiet",
    "lint:relaxed": "eslint src --quiet",
    "lint:theme": "cross-env ESLINT_THEME_STRICT=1 eslint src --max-warnings 0",
    "lint:perf": "cross-env ESLINT_STRICT=1 ESLINT_PERF_STRICT=1 eslint src --max-warnings 0",
    "lint:style": "stylelint \"src/**/*.{scss,vue}\"",
    "perf:check": "npm run lint:perf && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "cy:open": "cypress open",
    "cy:run": "cypress run"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@livekit/krisp-noise-filter": "^0.4.1",
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "@simplewebauthn/browser": "^13.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/vue-virtual": "^3.13.25",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-bold": "^3.23.6",
    "@tiptap/extension-code": "^3.23.6",
    "@tiptap/extension-italic": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-strike": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/vue-3": "^3.23.6",
    "browser-image-compression": "^2.0.2",
    "dompurify": "^3.4.1",
    "katex": "^0.16.46",
    "livekit-client": "^2.18.6",
    "marked": "^18.0.4",
    "marked-footnote": "^1.4.0",
    "pdfjs-dist": "^5.4.296",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.3",
    "twemoji": "^14.0.2",
    "unicode-emoji-json": "^0.9.0",
    "vite-plugin-compression2": "^2.5.3",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "cypress": "^15.15.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.11",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "qs": "6.15.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.99.0",
    "stylelint": "^17.9.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.6",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.9"
  }
}
