{
  "compilerOptions": {
    "target": "es2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2021"],
    "rootDir": "..",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../shared/mediaCdn.ts",
    "../shared/echoUploadStorageKey.ts",
    "../shared/echoS3ReadThrough.ts"
  ],
  "exclude": ["node_modules", "src/tests", "../shared/**/*.test.ts"]
}
