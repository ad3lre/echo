        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre quem está conectado no Discord para o canal de voz vinculado. O Echo fica somente para exibição — entre na voz pelo Discord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige, wer im verknüpften Sprachkanal auf Discord verbunden ist. Echo bleibt reine Anzeige – tritt dem Sprachkanal in Discord bei."
