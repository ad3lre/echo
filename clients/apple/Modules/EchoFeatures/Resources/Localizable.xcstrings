    "Developer Mode and Bug Hunter are device-only options. Bug Hunter keeps a bounded, privacy-safe trace in memory and clears it when disabled.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer Mode and Bug Hunter are device-only options. Bug Hunter keeps a bounded, privacy-safe trace in memory and clears it when disabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de desarrollador y el cazador de errores son opciones exclusivas del dispositivo. Bug Hunter mantiene un rastro limitado y seguro para la privacidad en la memoria y lo borra cuando está deshabilitado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Modo desenvolvedor e o Caçador de Bugs são opções exclusivas do dispositivo. O Caçador de Bugs mantém um registro limitado e seguro para a privacidade na memória e o apaga quando é desativado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklermodus und Bug Hunter sind reine Geräteoptionen. Bug Hunter speichert einen begrenzten, datenschutzsicheren Verlauf im Speicher und löscht ihn beim Deaktivieren."
          }
        }
      }
    },
