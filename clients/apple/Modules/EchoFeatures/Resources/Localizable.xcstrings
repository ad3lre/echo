        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco e o Echo configurará a publicação no Discord para você. Cole um link somente se seu administrador tiver fornecido um para usar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Feld leer, dann richtet Echo das Posten nach Discord für dich ein. Füge nur dann einen Link ein, wenn dein Admin dir einen gegeben hat."
