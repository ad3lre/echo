    "Upload videos to a shared queue and play them in sync over voice. The host drives playback; everyone else follows automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload videos to a shared queue and play them in sync over voice. The host drives playback; everyone else follows automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube vídeos a una cola compartida y reprodúcelos sincronizados por voz. El anfitrión controla la reproducción; los demás lo siguen automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie vídeos para uma fila compartilhada e reproduza-os sincronizados por voz. O anfitrião controla a reprodução; os demais acompanham automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Videos in eine gemeinsame Warteschlange hoch und spiele sie synchron per Sprachkanal ab. Der Host steuert die Wiedergabe; alle anderen folgen automatisch."
          }
        }
      },
      "generatesSymbol": false
    },
