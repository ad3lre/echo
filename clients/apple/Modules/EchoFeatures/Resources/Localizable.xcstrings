    "Dark, Light, Amoled, and Sunny adapt Echo’s surfaces; density and accents apply across the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark, Light, Amoled, and Sunny adapt Echo’s surfaces; density and accents apply across the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscuro, Claro, Amoled y Sunny adaptan las superficies de Echo; la densidad y los acentos se aplican en toda la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
