        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank and Echo will set up posting to Discord for you. Paste a link only if your admin gave you one to use instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco y Echo configurará la publicación en Discord por ti. Pega un enlace solo si tu administrador te dio uno para usar."
          }
