    "When enabled, Echo shows live Discord voice rosters for voice channels in this category. Echo voice join stays off — use Discord to participate in voice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Echo shows live Discord voice rosters for voice channels in this category. Echo voice join stays off — use Discord to participate in voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se activa, Echo muestra en vivo quién está en los canales de voz de Discord de esta categoría. Unirse a la voz en Echo sigue desactivado: usa Discord para participar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Echo mostra listas ao vivo de participantes de voz do Discord para os canais de voz desta categoria. A entrada por voz no Echo continua desativada — use o Discord para participar da voz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, zeigt Echo live die Discord-Sprachlisten für Sprachkanäle in dieser Kategorie. Der Sprachbeitritt in Echo bleibt deaktiviert – nutze Discord, um an der Sprache teilzunehmen."
          }
        }
      },
      "generatesSymbol": false
    },
    "When set, only Discord voice channels under this Discord category id are mirrored into this Echo category. Developer Mode → right-click Discord category → Copy ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When set, only Discord voice channels under this Discord category id are mirrored into this Echo category. Developer Mode → right-click Discord category → Copy ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se define, solo se reflejan en esta categoría de Echo los canales de voz de Discord bajo ese ID de categoría. Modo desarrollador → clic derecho en la categoría de Discord → Copiar ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando definido, apenas os canais de voz do Discord sob este ID de categoria do Discord são espelhados nesta categoria do Echo. Modo desenvolvedor → clique com o botão direito na categoria do Discord → Copiar ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn gesetzt, werden nur Discord-Sprachkanäle unter dieser Discord-Kategorie-ID in diese Echo-Kategorie gespiegelt. Entwicklermodus → Rechtsklick auf die Discord-Kategorie → ID kopieren."
          }
        }
      },
      "generatesSymbol": false
    },
