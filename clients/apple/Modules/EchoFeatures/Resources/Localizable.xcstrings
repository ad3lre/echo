        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo utiliza el tipo dinámico en todas las configuraciones nativas."
          }
        }
      }
    },
    "Echo uses the information needed to provide your account, conversations, safety systems, and notifications. You control optional analytics, discoverability, read receipts, and personalized tips in Data & Privacy. You can export or delete your account there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo uses the information needed to provide your account, conversations, safety systems, and notifications. You control optional analytics, discoverability, read receipts, and personalized tips in Data & Privacy. You can export or delete your account there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo utiliza la información necesaria para proporcionar su cuenta, conversaciones, sistemas de seguridad y notificaciones. Usted controla los análisis opcionales, la capacidad de descubrimiento, los recibos de lectura y los consejos personalizados en Datos y privacidad. Puede exportar o eliminar su cuenta allí."
          }
        }
      }
    },
