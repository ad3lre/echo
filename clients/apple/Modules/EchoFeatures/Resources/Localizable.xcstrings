    "Members who start a post get these extras on their own thread only. Server roles and channel permissions still apply for everything else.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members who start a post get these extras on their own thread only. Server roles and channel permissions still apply for everything else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros que inician una publicación reciben estos extras solo en su propio hilo. Los roles del servidor y los permisos del canal siguen aplicándose a todo lo demás."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Membros que iniciam uma publicação recebem estes extras apenas no próprio tópico. Cargos do servidor e permissões do canal continuam valendo para todo o resto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitglieder, die einen Beitrag starten, erhalten diese Extras nur in ihrem eigenen Thread. Serverrollen und Kanalberechtigungen gelten weiterhin für alles andere."
          }
        }
      },
      "generatesSymbol": false
    },
