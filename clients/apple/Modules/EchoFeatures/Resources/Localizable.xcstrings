    "New devices must be explicitly approved. Revoking a device removes its ability to receive future encrypted messages from this account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New devices must be explicitly approved. Revoking a device removes its ability to receive future encrypted messages from this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos nuevos deben aprobarse de forma explícita. Revocar un dispositivo elimina su capacidad de recibir futuros mensajes cifrados de esta cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos dispositivos precisam ser aprovados explicitamente. Revogar um dispositivo remove a capacidade de receber futuras mensagens criptografadas desta conta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Geräte müssen ausdrücklich genehmigt werden. Das Widerrufen eines Geräts entzieht ihm die Möglichkeit, künftig verschlüsselte Nachrichten dieses Kontos zu empfangen."
          }
        }
      },
      "generatesSymbol": false
    },
