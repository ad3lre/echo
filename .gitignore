# Gitignore for Echo project

# Dependencies
/node_modules
/frontend/node_modules
/backend/node_modules
/scripts/node_modules
/marketing/node_modules
/marketing/.astro/
/marketing/dist

# Production builds
/dist
# Desktop/Linux release bundles (build locally or attach to CI releases; GitLab rejects >100MiB blobs)
/linux-dist/
/frontend/dist
/backend/dist
/bot/dist
/voice-sidecar/dist
# Accidental tsc emit into TS-only tree (shared has no hand-written .js sources)
/shared/**/*.js
/shared/**/*.js.map
/voice-sidecar/node_modules
/src-tauri/target
/src-tauri/ios-sim-derived
# Tauri updater private key (never commit; pubkey `echo-update.key.pub` is tracked)
/src-tauri/echo-update.key
# Android release signing (Play upload key / local keystore; never commit)
# (keystore.properties.example is a different filename and can be tracked)
**/keystore.properties
src-tauri/gen/android/**/*.jks
/bot/exports/

# Test coverage (Vitest v8)
/frontend/coverage

# Inter woff2 for oauth-desktop-bridge (copied from @fontsource/inter at prebuild)
/frontend/public/fonts/*.woff2

# Cypress (frontend E2E)
/frontend/cypress/screenshots
/frontend/cypress/videos
/frontend/cypress/downloads

# TLS / PKCS private material (accidental commits)
*.pem
*.p12

# Local env / secrets (never commit). Keep tracked templates only.
.env
**/.env
.env.*
!.env.example
!**/.env.example
.envrc
.direnv/

# Cursor, AI coding assistants, and local tool state (never commit)
.cursor/
.claude/
.windsurf/
.continue/
.specstory/
.agent/
.aider*
.aider.chat.history.md

# LAN dev (generated by `npm run lan:sync`) — covered by `.env.*` but listed for clarity
/infra/livekit/livekit.runtime.yaml

# TypeScript incremental build cache
*.tsbuildinfo

# VPS launcher (PID + logs from scripts/vps-serve.mjs)
/logs/vps/
/logs/trivy-cache*/

# Generated docs / tool dumps (rebuild with npm scripts; do not commit)
/docs/overview/tree.md
/docs/archive/
/console-log.json
/frontend/lint-warnings.json
/frontend/vitest_report.json
/frontend/vitest_out.txt

# Logs
# Chrome DevTools performance traces (often exceed Git host blob limits)
Trace-*.json
_console-tail.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.idea/
.vscode/
.fleet/
.zed/
*.code-workspace
*.suo
*.user
*.bak
*.log
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgm
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.vsp
*.sdf
*.vssscc
*.vspscc
*.dsmd
*.mdf
*.ldf
*.src
*.ncb
*.opensdf
*.safetensors

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
*.exe
*.dll
*.so
*.o
*.a
*.lib
*.exp
*.pyc
*.class
*.jar
# Gradle wrapper must be committed (standard practice); *.jar above would ignore it.
!src-tauri/gen/android/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.7z

# Docker — keep repo `docker-compose.yml`; put machine-specific overrides here (merged by Compose)
docker-compose.yaml.backup
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Prisma
/backend/prisma/migrations

# Twemoji assets (generated by scripts/copy-twemoji.js)
/frontend/public/twemoji

# Emoji search index (generated by scripts/build-emoji-search-index.js)
/frontend/public/emoji-search-index.json

# Local disk uploads (when S3 is not configured)
/data/echo-local-uploads
/backend/data/echo-local-uploads

# Session diagnostics (local dev artifacts; see docs/operations/session-diagnostics.md)
/backend/.diagnostics/
/.diagnostics/

# HTTP Archive captures (often contain cookies / tokens)
*.har

# Local security / pentest artifacts (regenerate with scripts/har-sanitize.mjs if needed)
/artifacts/

# Scanner JSON dumps under logs/ (VPS logs stay under /logs/vps/, already ignored)
/logs/*.json

# Add any other files or directories that should be ignored
