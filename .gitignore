# Gitignore for Echo project

# Watchdog runtime stats (written by scripts/watchdog.mjs)
/server/ops/scripts/downtime-stats.json

# Local runtime logs (PM2 / vps-serve rolling output)
/logs/

# Dependencies
/node_modules
/clients/web/node_modules
/server/backend/node_modules
/server/ops/scripts/node_modules
/server/ops/scripts/node_modules
/marketing/node_modules
/marketing/.astro/
/marketing/dist

# Production builds
/dist
# Desktop/Linux release bundles (build locally or attach to CI releases; GitLab rejects >100MiB blobs)
/linux-dist/
/clients/web/dist
/server/backend/dist
/bot/dist
/server/voice/dist
/server/activities/dist
# Accidental tsc emit into TS-only tree (shared has no hand-written .js sources)
/contracts/**/*.js
/contracts/**/*.js.map
/server/voice/node_modules
/server/activities/node_modules
/server/media/node_modules
/server/media/dist
/bot/exports/

# Test coverage (Vitest v8)
/clients/web/coverage

# Local font caches (if any)
/clients/web/public/fonts/*.woff2

# Cypress (frontend E2E)
/clients/web/cypress/screenshots
/clients/web/cypress/videos
/clients/web/cypress/downloads

# Production perf runs (keep committed baselines under server/ops/perf/baselines/)
/server/ops/perf/.auth/
/server/ops/perf/results/
/server/ops/perf/perf/

# Accidental pre-nest workspace leftovers (real trees live under clients/ and server/)
/activities/
/backend/
/media/
/ops/
/perf/
/voice/
/web/

# TLS / PKCS private material (accidental commits)
*.pem
*.p12

# Apple local e2e credentials written by `npm run apple:e2e`
clients/apple/.e2e-local.json

# Local env / secrets (never commit). Keep tracked templates only.
.env
**/.env
.env.*
!.env.example
!**/.env.example
!.env.perf.example
.envrc
.direnv/

# Cursor, AI coding assistants, and local tool state (never commit)
CLAUDE.md
.cursor/
.claude/
.windsurf/
.continue/
.specstory/
.agent/
.aider*
.aider.chat.history.md

# LAN dev (generated by `npm run lan:sync`) — covered by `.env.*` but listed for clarity
/infra/livekit/livekit.runtime.yaml
/server/ops/infra/livekit/livekit.runtime.yaml

# TypeScript incremental build cache
*.tsbuildinfo

# VPS launcher (PID + logs from server/ops/scripts/vps-serve.mjs)
/logs/vps/
/logs/trivy-cache*/

# Generated docs / tool dumps (rebuild with npm scripts; do not commit)
/docs/overview/tree.md
/docs/archive/
/console-log.json
/clients/web/lint-warnings.json
/clients/web/vitest_report.json
/clients/web/vitest_out.txt

# Logs
# Chrome DevTools performance traces (often exceed Git host blob limits)
Trace-*.json
_console-tail.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor directories and files
.idea/
.vscode/
.fleet/
.zed/
*.code-workspace
*.suo
*.user
*.bak
*.log
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgm
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.vsp
*.sdf
*.vssscc
*.vspscc
*.dsmd
*.mdf
*.ldf
*.src
*.ncb
*.opensdf
*.safetensors

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
*.exe
*.dll
*.so
*.o
*.a
*.lib
*.exp
*.pyc
*.class
*.jar
# Gradle wrapper must be committed (standard practice); *.jar above would ignore it.
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.7z

# Docker — keep repo `docker-compose.yml`; put machine-specific overrides here (merged by Compose)
docker-compose.yaml.backup
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Prisma
/server/backend/prisma/migrations

# Twemoji assets (generated by scripts/copy-twemoji.mjs)
/clients/web/public/twemoji

# Emoji search index (generated by scripts/build-emoji-search-index.mjs)
/clients/web/public/emoji-search-index.json

# Watch Together manual e2e sample (local only; see server/backend/src/tests/vcWatchTogetherRealMp4.*)
/clients/web/public/wt-e2e-sample.mp4

# Local disk uploads (when S3 is not configured)
/data/echo-local-uploads
/server/backend/data/echo-local-uploads

# Session diagnostics (local dev artifacts; see docs/operations/session-diagnostics.md)
/server/backend/.diagnostics/
/.diagnostics/

# HTTP Archive captures (often contain cookies / tokens)
*.har

# Local security / pentest artifacts (regenerate with scripts/har-sanitize.mjs if needed)
/artifacts/

# Scanner JSON dumps under logs/ (VPS logs stay under /logs/vps/, already ignored)
/logs/*.json

# Add any other files or directories that should be ignored

# Local instance policy (template remains: echo.instance.example.json)
echo.instance.json

# Apple/SwiftPM local build (never commit)
clients/apple/.build/
clients/apple/.swiftpm/
clients/apple/**/DerivedData/
