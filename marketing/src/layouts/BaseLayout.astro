---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import { CHAT_APP_ORIGIN } from '../site';
import {
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_PATH,
  OG_IMAGE_WIDTH,
} from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  structuredData?: unknown;
  robots?: string;
  noindex?: boolean;
  locale?: string;
  hreflangAlternates?: { locale: string; path: string }[];
}

const {
  title,
  description,
  canonicalPath = '/',
  ogImagePath = OG_IMAGE_PATH,
  ogImageAlt = OG_IMAGE_ALT,
  structuredData,
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  noindex = false,
  locale = 'en',
  hreflangAlternates = [],
} = Astro.props;

const pageUrl = new URL(canonicalPath, Astro.site);
const ogImageUrl = new URL(ogImagePath, Astro.site);
const robotsContent = noindex ? 'noindex,follow' : robots;
const ogLocale = locale === 'en' ? 'en_US' : `${locale}_${locale.toUpperCase()}`;
const ogImageType = ogImagePath.endsWith('.svg')
  ? 'image/svg+xml'
  : ogImagePath.endsWith('.png')
    ? 'image/png'
    : 'image/jpeg';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Echo" />
    <meta name="theme-color" content="#f9f9fb" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={pageUrl.toString()} />
    {
      hreflangAlternates.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt.locale}
          href={new URL(alt.path, Astro.site).toString()}
        />
      ))
    }
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" href="/echo-rounded-logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="preconnect" href={CHAT_APP_ORIGIN} crossorigin />
    <link rel="dns-prefetch" href={CHAT_APP_ORIGIN} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Echo" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.toString()} />
    <meta property="og:image" content={ogImageUrl.toString()} />
    <meta property="og:image:secure_url" content={ogImageUrl.toString()} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.toString()} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'en' ? 'Skip to content' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
