---
/**
 * Screen-share marketing widget: avatars + readable shared desktop, no copy (VoiceCallWidget rhythm).
 */
---

<div class="shw" aria-hidden="true">
  <div class="shw__plate">
    <div class="shw__row shw__row--stage">
      <div class="shw-mini shw-mini--violet">
        <div class="shw-mini__ring">
          <div class="shw-mini__hood"></div>
          <div class="shw-mini__eyes">
            <span class="shw-mini__eye"><span class="shw-mini__pupil"></span></span>
            <span class="shw-mini__eye"><span class="shw-mini__pupil"></span></span>
          </div>
        </div>
      </div>

      <div class="shw-screen">
        <div class="shw-screen__inner">
          <div class="shw-screen__chrome"></div>
          <div class="shw-screen__desk">
            <div class="shw-screen__rail">
              <span></span><span></span><span class="is-hi"></span><span></span>
            </div>
            <div class="shw-screen__main">
              <div class="shw-screen__tile"></div>
              <div class="shw-screen__lines">
                <span></span><span></span><span class="is-short"></span>
              </div>
            </div>
            <div class="shw-screen__pip"></div>
            <svg class="shw-screen__cursor" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true">
              <path
                d="M1.5 1.5v6.8l2-1.7 1.6 2.9 1-.5-1.6-3h2.9L1.5 1.5z"
                fill="#0f172a"
                stroke="#fff"
                stroke-width="0.85"
                stroke-linejoin="round"></path>
            </svg>
          </div>
        </div>
      </div>

      <div class="shw-watchers">
        <div class="shw-mini shw-mini--amber">
          <div class="shw-mini__ring">
            <div class="shw-mini__hood"></div>
            <div class="shw-mini__eyes">
              <span class="shw-mini__eye"><span class="shw-mini__pupil"></span></span>
              <span class="shw-mini__eye"><span class="shw-mini__pupil"></span></span>
            </div>
          </div>
        </div>
        <div class="shw-mini shw-mini--green">
          <div class="shw-mini__ring">
            <div class="shw-mini__hood"></div>
            <div class="shw-mini__eyes">
              <span class="shw-mini__eye"><span class="shw-mini__pupil"></span></span>
              <span class="shw-mini__eye"><span class="shw-mini__pupil"></span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="shw__row shw__row--controls">
      <span class="shw__ctrl">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" fill="none"></rect>
          <path d="M8 21h8M12 17v4"></path>
          <path d="M12 9V5M12 5l-2 2M12 5l2 2"></path>
        </svg>
      </span>
      <span class="shw__ctrl">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2" fill="none"></rect>
          <rect x="12" y="11" width="9" height="7" rx="1" fill="none"></rect>
        </svg>
      </span>
      <span class="shw__ctrl">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="1" fill="none"></rect>
          <rect x="14" y="3" width="7" height="7" rx="1" fill="none"></rect>
          <rect x="3" y="14" width="7" height="7" rx="1" fill="none"></rect>
          <rect x="14" y="14" width="7" height="7" rx="1" fill="none"></rect>
        </svg>
      </span>
    </div>
  </div>
</div>

<style>
  .shw {
    --shw-panel: #f3f1f9;
    --shw-edge: rgba(88, 86, 214, 0.07);
    --shw-tile: #7c74e0;
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .shw__plate {
    border-radius: 16px;
    background: var(--shw-panel);
    border: 1px solid var(--shw-edge);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.65),
      0 1px 2px rgba(25, 20, 60, 0.04);
    padding: 14px 14px 13px;
    overflow: hidden;
  }

  .shw__row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shw__row--stage {
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    padding: 2px 0 1px;
  }

  .shw__row--controls {
    gap: 11px;
    margin-top: 14px;
    padding-top: 2px;
  }

  /* —— Mini hood avatars (VoiceCallWidget parity) —— */
  .shw-mini {
    flex-shrink: 0;
  }

  .shw-mini__ring {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow:
      inset 0 -4px 7px rgba(30, 25, 70, 0.1),
      inset 0 1px 1px rgba(255, 255, 255, 0.55),
      0 1px 4px rgba(50, 40, 100, 0.12);
  }

  .shw-mini__hood {
    position: absolute;
    left: 50%;
    bottom: 8%;
    width: 76%;
    height: 56%;
    transform: translateX(-50%);
    border-radius: 50% 50% 42% 42% / 58% 58% 36% 36%;
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.12);
  }

  .shw-mini__eyes {
    position: absolute;
    left: 50%;
    top: 41%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 5px;
    z-index: 2;
  }

  .shw-mini__eye {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.05);
  }

  .shw-mini__eye:last-child .shw-mini__pupil {
    left: 42%;
  }

  .shw-mini__pupil {
    position: absolute;
    left: 56%;
    top: 48%;
    width: 2.5px;
    height: 2.5px;
    margin: -1.25px 0 0 -1.25px;
    border-radius: 50%;
    background: #14122a;
  }

  .shw-mini--violet .shw-mini__ring {
    background: linear-gradient(168deg, #ede9fe 0%, #c4b5fd 55%, #a78bfa 100%);
  }
  .shw-mini--violet .shw-mini__hood {
    background: linear-gradient(180deg, #4c3a8f 0%, #3b2f6b 55%, #2a1f4d 100%);
  }

  .shw-mini--amber .shw-mini__ring {
    background: linear-gradient(168deg, #ffedd5 0%, #fdba74 55%, #fb923c 100%);
  }
  .shw-mini--amber .shw-mini__hood {
    background: linear-gradient(180deg, #9a3412 0%, #7c2d12 55%, #5c220e 100%);
  }

  .shw-mini--green .shw-mini__ring {
    background: linear-gradient(168deg, #dcfce7 0%, #86efac 55%, #4ade80 100%);
  }
  .shw-mini--green .shw-mini__hood {
    background: linear-gradient(180deg, #166534 0%, #14532d 55%, #0f3d24 100%);
  }

  .shw-mini__ring::after {
    content: '';
    position: absolute;
    left: 14%;
    top: 11%;
    right: 14%;
    height: 36%;
    border-radius: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 75%);
    pointer-events: none;
  }

  .shw-watchers {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    gap: 0;
  }

  .shw-watchers .shw-mini + .shw-mini {
    margin-top: -8px;
  }

  /* —— Shared desktop: flat, borderless —— */
  .shw-screen {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 58px;
    border-radius: 12px;
    background: #f1f0f6;
    border: none;
    box-shadow: none;
    padding: 0;
    min-width: 108px;
    max-width: 168px;
    overflow: hidden;
  }

  .shw-screen__inner {
    height: 100%;
    border-radius: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .shw-screen__chrome {
    height: 6px;
    flex-shrink: 0;
    background: #e9e8ef;
    border-bottom: none;
  }

  .shw-screen__desk {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    background: #f6f6f9;
  }

  .shw-screen__rail {
    width: 22%;
    flex-shrink: 0;
    padding: 4px 3px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: #e8e4f4;
    border-right: none;
  }

  .shw-screen__rail span {
    height: 2.5px;
    border-radius: 2px;
    background: rgba(88, 86, 214, 0.18);
  }

  .shw-screen__rail span.is-hi {
    background: #5856d6;
    opacity: 1;
  }

  .shw-screen__main {
    flex: 1;
    min-width: 0;
    padding: 4px 4px 3px 3px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .shw-screen__tile {
    height: 14px;
    border-radius: 4px;
    background: var(--shw-tile);
    border: none;
    box-shadow: none;
  }

  .shw-screen__lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .shw-screen__lines span {
    height: 2px;
    border-radius: 999px;
    background: rgba(91, 91, 110, 0.1);
    width: 100%;
  }

  .shw-screen__lines span.is-short {
    width: 62%;
  }

  .shw-screen__pip {
    position: absolute;
    right: 5px;
    bottom: 4px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #d4cef8;
    border: none;
    box-shadow: none;
    z-index: 2;
  }

  .shw-screen__pip::after {
    content: '';
    position: absolute;
    inset: 22% 28% 38% 28%;
    border-radius: 50% 50% 40% 40% / 55% 55% 38% 38%;
    background: #4c3a8f;
  }

  .shw-screen__cursor {
    position: absolute;
    right: 22%;
    bottom: 18%;
    z-index: 3;
  }

  /* —— Control row (VoiceCallWidget-style, icons only) —— */
  .shw__ctrl {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid #e6e6ec;
    color: #25252c;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  .shw__ctrl svg {
    display: block;
    margin-top: 0.5px;
  }
</style>
