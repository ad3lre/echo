---
import LegalMarkdownArticle from '../components/LegalMarkdownArticle.astro';
import communityGuidelinesMd from '../../../terms/en-US/community-guidelines.md?raw';

const title = 'Community Guidelines | Echo';
const description = 'Our community guidelines for maintaining a safe and respectful environment on Echo.';
const lastUpdated = '3 June 2026';
---

<LegalMarkdownArticle
  title={title}
  pageHeading="Community Guidelines"
  description={description}
  canonicalPath="/community-guidelines"
  lastUpdated={lastUpdated}
  markdown={communityGuidelinesMd}
  footerLinks={[
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/terms', label: 'Terms of Service' },
    { href: '/attributions', label: 'Attributions' },
  ]}
/>
