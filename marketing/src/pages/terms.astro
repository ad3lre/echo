---
import LegalMarkdownArticle from '../components/LegalMarkdownArticle.astro';
import termsMd from '../../../terms/en-US/terms.md?raw';

const title = 'Terms of Service | Echo';
const description = 'Read the Terms of Service for using Echo, the privacy-focused communication platform.';
const lastUpdated = '23 March 2026';
---

<LegalMarkdownArticle
  title={title}
  pageHeading="Terms of Service"
  description={description}
  canonicalPath="/terms"
  lastUpdated={lastUpdated}
  markdown={termsMd}
  footerLinks={[
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/community-guidelines', label: 'Community Guidelines' },
    { href: '/attributions', label: 'Attributions' },
  ]}
/>
