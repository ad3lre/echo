<script>
  import { bootAdelApprovalPoll } from '../lib/adelApprovalPoll/client';

  const root = document.querySelector('.poll-app');
  const endpoint = root?.getAttribute('data-poll-endpoint') || '';

  if (endpoint) {
    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          void bootAdelApprovalPoll(endpoint);
        },
        { once: true },
      );
    } else {
      void bootAdelApprovalPoll(endpoint);
    }
  }
</script>
