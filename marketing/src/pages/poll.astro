---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageStructuredData } from '../lib/seo';
import { CHAT_APP_ORIGIN } from '../site';

const title = 'Adel Approval Poll | Echo';
const description =
  'Take the Adel Approval Poll and see how you rank on the shared leaderboard.';

const POLL_ENDPOINT = `${CHAT_APP_ORIGIN}/api/v1/echo/marketing-poll/adel-approval-v2`;

const structuredData = pageStructuredData({
  title,
  description,
  path: '/poll',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Poll', path: '/poll' },
  ],
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/poll"
  structuredData={structuredData}
>
  <div class="poll-app" data-poll-endpoint={POLL_ENDPOINT}>
    <div
      id="liveOverlay"
      class="live-overlay hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Live update"
      hidden
    >
      <div class="live-overlay-card">
        <button type="button" class="live-overlay-close" id="liveOverlayClose">
          Close
        </button>
        <p class="live-overlay-caption" id="liveOverlayCaption" hidden></p>
        <img
          class="live-overlay-image"
          id="liveOverlayImage"
          alt=""
          decoding="async"
        />
      </div>
    </div>
    <div class="poll-sparkles" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <a class="poll-home" href="/">
      <span class="poll-home-icon" aria-hidden="true">🏠</span>
      Echo
    </a>
    <main class="shell">
      <div class="poll-tabs" role="tablist" aria-label="Poll sections">
        <button
          type="button"
          class="poll-tab"
          role="tab"
          id="tabPoll"
          aria-selected="true"
          aria-controls="panelPoll"
        >
          Poll
        </button>
        <button
          type="button"
          class="poll-tab"
          role="tab"
          id="tabCompare"
          aria-selected="false"
          aria-controls="panelCompare"
        >
          Compare
        </button>
      </div>

      <div id="panelPoll" role="tabpanel" aria-labelledby="tabPoll">
      <section class="card gate" id="nameGate">
        <div class="gate-badge" aria-hidden="true">
          <span class="gate-badge-glow"></span>
          <span class="gate-badge-emoji">🎯</span>
        </div>
        <p class="gate-kicker">Adel Approval Poll</p>
        <h1>What's your name?</h1>
        <p>
          Fifty quick questions. Climb the board. One shot — make it count.
        </p>
        <div class="topic-chip-row" aria-hidden="true">
          <span class="topic-chip">🤝 Friendship</span>
          <span class="topic-chip">😂 Humor</span>
          <span class="topic-chip">🧠 Thinking</span>
          <span class="topic-chip">⚖️ Judgment</span>
          <span class="topic-chip">💚 Emotion</span>
          <span class="topic-chip">🗽 Freedom</span>
        </div>
        <p class="gate-status" id="gateStatus" aria-live="polite"></p>
        <form id="nameForm" novalidate>
          <div class="name-row">
            <input
              class="name-input"
              id="nameInput"
              type="text"
              maxlength="30"
              autocomplete="nickname"
              placeholder="Your nickname"
              aria-label="Your name"
            />
            <button class="btn primary" type="submit">
              <span aria-hidden="true">🚀</span> Let's go
            </button>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label>
              Website
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <div class="gate-error" id="nameError" role="alert"></div>
        </form>
      </section>

      <section id="quizApp" class="hidden">
        <div class="topline">
          <span class="player-pill" id="playerLabel"></span>
          <strong id="progressText">1 / 50</strong>
        </div>
        <div class="track"><div class="fill" id="progressFill"></div></div>
        <section class="card question-card" id="questionCard">
          <div class="question-body" id="questionMount"></div>
          <p class="submit-error" id="submitError" role="alert"></p>
          <nav class="nav" aria-label="Quiz navigation">
            <button class="btn" id="prevBtn" type="button">← Back</button>
            <button class="btn primary" id="nextBtn" type="button" disabled>
              Next →
            </button>
          </nav>
        </section>
      </section>

      <section class="card results hidden" id="results" aria-live="polite">
        <div class="result-confetti" aria-hidden="true">
          <span>✨</span><span>🎉</span><span>⭐</span><span>💫</span>
        </div>
        <div class="result-top">
          <div class="score-ring" id="scoreRing">
            <div class="score-inside">
              <b id="scoreNumber">0</b>
              <span>approval</span>
            </div>
          </div>
          <div>
            <p class="result-name" id="resultName"></p>
            <h2 class="verdict" id="verdict"></h2>
            <p class="verdict-copy" id="verdictCopy"></p>
            <div class="signature">
              <div class="signature-item">
                <span>🔥 Strongest match</span>
                <b id="strongest"></b>
              </div>
              <div class="signature-item">
                <span>🧊 Biggest clash</span>
                <b id="weakest"></b>
              </div>
            </div>
          </div>
        </div>
        <div class="breakdown">
          <h3>📊 Your score by topic</h3>
          <div id="breakdownMount"></div>
        </div>
        <div class="leaderboard">
          <h3>🏆 Leaderboard</h3>
          <p class="leader-note" id="leaderNote">
            Live board · one attempt each · flags show where people played from
          </p>
          <div class="leader-list" id="leaderboardMount"></div>
        </div>
        <div class="result-actions">
          <button class="btn primary" id="copyBtn" type="button">
            📋 Copy score
          </button>
        </div>
        <p class="foot-note">
          Just for fun — not a scientific personality test.
        </p>
      </section>
      </div>

      <div
        id="panelCompare"
        class="hidden"
        role="tabpanel"
        aria-labelledby="tabCompare"
        hidden
      >
        <section class="card compare-card">
          <div class="compare-hero">
            <span class="compare-kicker">Cross compatibility</span>
            <h2>How do two people line up?</h2>
            <p>
              Pick anyone on the board and see where they match, clash, and how
              compatible their instincts are.
            </p>
          </div>
          <div class="compare-pickers">
            <label class="compare-picker">
              <span>Person A</span>
              <select id="compareA" aria-label="First person"></select>
            </label>
            <div class="compare-vs" aria-hidden="true">vs</div>
            <label class="compare-picker">
              <span>Person B</span>
              <select id="compareB" aria-label="Second person"></select>
            </label>
          </div>
          <div id="compareMount" class="compare-mount">
            <div class="empty-board">Need at least two scores on the board.</div>
          </div>
        </section>
      </div>
    </main>
  </div>
</BaseLayout>

<style is:global>
  body:has(.poll-app) {
    background: #080a0f;
    color: #f5f7fb;
  }

  .live-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 18px;
    background: rgba(4, 6, 12, 0.78);
    backdrop-filter: blur(8px);
  }

  .live-overlay.hidden,
  .live-overlay[hidden] {
    display: none !important;
  }

  .live-overlay-card {
    position: relative;
    width: min(920px, 100%);
    max-height: min(88vh, 900px);
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    background: rgba(18, 22, 33, 0.96);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
    overflow: auto;
  }

  .live-overlay-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: #f5f7fb;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .live-overlay-caption {
    margin: 0 56px 14px 0;
    color: #d6dce7;
    font-size: 1rem;
    font-weight: 750;
  }

  .live-overlay-image {
    display: block;
    width: 100%;
    max-height: min(78vh, 820px);
    object-fit: contain;
    border-radius: 14px;
    background: rgba(0, 0, 0, 0.25);
  }

  .poll-app {
    --bg: #080a0f;
    --panel: #121621;
    --panel2: #171c29;
    --text: #f5f7fb;
    --muted: #9ca7ba;
    --line: rgba(255, 255, 255, 0.1);
    --accent: #a794ff;
    --accent2: #68dfca;
    --danger: #ff8296;
    --radius: 22px;
    position: relative;
    overflow: clip;
    min-height: 100vh;
    color: var(--text);
    background:
      radial-gradient(
        circle at 12% -5%,
        rgba(167, 148, 255, 0.22),
        transparent 34rem
      ),
      radial-gradient(
        circle at 95% 20%,
        rgba(104, 223, 202, 0.14),
        transparent 28rem
      ),
      radial-gradient(
        circle at 50% 110%,
        rgba(255, 184, 107, 0.1),
        transparent 28rem
      ),
      var(--bg);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    line-height: 1.45;
  }

  .poll-sparkles {
    pointer-events: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .poll-sparkles span {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    box-shadow: 0 0 16px rgba(167, 148, 255, 0.55);
    animation: poll-float 9s ease-in-out infinite;
  }

  .poll-sparkles span:nth-child(1) {
    top: 12%;
    left: 8%;
    animation-delay: 0s;
  }
  .poll-sparkles span:nth-child(2) {
    top: 22%;
    right: 12%;
    width: 6px;
    height: 6px;
    animation-delay: -2s;
    background: rgba(104, 223, 202, 0.5);
  }
  .poll-sparkles span:nth-child(3) {
    top: 58%;
    left: 6%;
    width: 10px;
    height: 10px;
    animation-delay: -4s;
    background: rgba(255, 184, 107, 0.45);
  }
  .poll-sparkles span:nth-child(4) {
    bottom: 18%;
    right: 10%;
    animation-delay: -1.5s;
  }
  .poll-sparkles span:nth-child(5) {
    top: 40%;
    left: 48%;
    width: 5px;
    height: 5px;
    animation-delay: -6s;
  }

  @keyframes poll-float {
    0%,
    100% {
      transform: translateY(0) scale(1);
      opacity: 0.35;
    }
    50% {
      transform: translateY(-18px) scale(1.2);
      opacity: 0.9;
    }
  }

  .poll-app * {
    box-sizing: border-box;
  }

  .poll-app .hidden {
    display: none !important;
  }

  .poll-app button,
  .poll-app input {
    font: inherit;
  }

  .poll-app button {
    color: inherit;
  }

  .poll-home {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0 max(12px, calc((100% - 760px) / 2));
    padding: 8px 14px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(18, 22, 33, 0.55);
    backdrop-filter: blur(8px);
    transition: color 0.13s ease, transform 0.13s ease;
  }

  .poll-home:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  .poll-home-icon {
    font-size: 0.95rem;
  }

  .poll-tabs {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 0 0 18px;
    padding: 6px;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.1));
    border-radius: 16px;
    background: rgba(18, 22, 33, 0.72);
  }

  .poll-tab {
    min-height: 44px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--muted, #9ca7ba);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .poll-tab[aria-selected='true'] {
    color: #090b10;
    background: linear-gradient(135deg, #a794ff, #68dfca);
  }

  .compare-card {
    padding: 28px 24px;
  }

  .compare-hero {
    text-align: center;
    margin-bottom: 22px;
  }

  .compare-kicker {
    display: inline-block;
    margin-bottom: 8px;
    color: #68dfca;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .compare-hero h2 {
    margin: 0 0 8px;
    font-size: clamp(1.7rem, 5vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .compare-hero p {
    margin: 0 auto;
    max-width: 34rem;
    color: #9ca7ba;
  }

  .compare-pickers {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    align-items: end;
    margin-bottom: 22px;
  }

  .compare-picker {
    display: grid;
    gap: 8px;
    text-align: left;
  }

  .compare-picker span {
    color: #9ca7ba;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .compare-picker select {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.045);
    color: #f5f7fb;
    font: inherit;
    font-weight: 700;
  }

  .compare-vs {
    padding-bottom: 12px;
    color: #9ca7ba;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .compare-score-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 22px;
  }

  .compare-ring {
    --score: 0;
    width: 140px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    position: relative;
    border-radius: 50%;
    background: conic-gradient(
      #68dfca calc(var(--score) * 1%),
      rgba(255, 255, 255, 0.08) 0
    );
  }

  .compare-ring:before {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: inherit;
    background: #171c29;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .compare-ring-inside {
    position: relative;
    text-align: center;
  }

  .compare-ring-inside b {
    display: block;
    font-size: 2.2rem;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .compare-ring-inside span {
    color: #9ca7ba;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .compare-headline {
    margin: 0 0 6px;
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .compare-copy {
    margin: 0;
    color: #9ca7ba;
  }

  .compare-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .compare-chip {
    padding: 7px 11px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.82rem;
    font-weight: 750;
  }

  .compare-topics {
    display: grid;
    gap: 12px;
    margin-top: 8px;
  }

  .compare-topic {
    padding: 12px 13px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
  }

  .compare-topic-head {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 0.9rem;
    font-weight: 750;
  }

  .compare-topic-head em {
    color: #9ca7ba;
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }

  .compare-dual {
    display: grid;
    gap: 6px;
  }

  .compare-dual-row {
    display: grid;
    grid-template-columns: 64px 1fr 42px;
    gap: 8px;
    align-items: center;
    font-size: 0.78rem;
  }

  .compare-dual-row span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #9ca7ba;
    font-weight: 700;
  }

  .compare-dual-row span:last-child {
    text-align: right;
    font-weight: 850;
    font-variant-numeric: tabular-nums;
  }

  .compare-dual-track {
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
  }

  .compare-dual-track i {
    display: block;
    height: 100%;
    border-radius: inherit;
  }

  @media (max-width: 620px) {
    .compare-pickers,
    .compare-score-row {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .compare-vs {
      padding: 0;
    }

    .compare-ring {
      justify-self: center;
    }

    .compare-picker {
      text-align: left;
    }
  }

  .poll-app .shell {
    width: min(760px, calc(100% - 24px));
    margin: 0 auto;
    padding: 12px 0 70px;
  }

  .poll-app .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(18, 22, 33, 0.95);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
  }

  .poll-app .gate {
    position: relative;
    max-width: 560px;
    margin: 6vh auto 0;
    padding: 32px 28px 28px;
    text-align: center;
    overflow: hidden;
  }

  .poll-app .gate-badge {
    position: relative;
    width: 88px;
    height: 88px;
    margin: 0 auto 18px;
    display: grid;
    place-items: center;
  }

  .poll-app .gate-badge-glow {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(167, 148, 255, 0.45),
      transparent 70%
    );
    animation: poll-pulse 2.8s ease-in-out infinite;
  }

  .poll-app .gate-badge-emoji {
    position: relative;
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(
      160deg,
      rgba(167, 148, 255, 0.28),
      rgba(104, 223, 202, 0.16)
    );
    font-size: 2.4rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.28);
  }

  @keyframes poll-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.12);
      opacity: 1;
    }
  }

  .poll-app .gate-kicker {
    margin: 0 0 8px !important;
    color: var(--accent2) !important;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .poll-app .gate h1 {
    margin: 0 0 8px;
    font-size: clamp(2rem, 8vw, 3.35rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .poll-app .gate p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .poll-app .topic-chip-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0 0 22px;
  }

  .poll-app .topic-chip {
    padding: 7px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: #d7deea;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .poll-app .gate-status {
    min-height: 1.2em;
    margin: 0 0 12px;
    color: #ffd4dc;
    font-size: 0.86rem;
  }

  .poll-app .name-row {
    display: flex;
    gap: 10px;
    text-align: left;
  }

  .poll-app #nameForm {
    text-align: left;
  }

  .poll-app .player-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 60%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    font-weight: 750;
  }

  .poll-app .player-pill::before {
    content: '🎮';
  }

  .poll-app .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--question-color, var(--accent)) 45%, transparent);
    background: color-mix(
      in srgb,
      var(--question-color, var(--accent)) 14%,
      rgba(255, 255, 255, 0.03)
    );
    color: var(--question-color, var(--accent));
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .poll-app .category-pill .cat-icon {
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .poll-app .option-letter {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    margin-right: 12px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
    color: var(--muted);
