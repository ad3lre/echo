---
import MarketingShell from '../layouts/MarketingShell.astro';
import { pageStructuredData } from '../lib/seo';
import { CHAT_APP_ORIGIN } from '../site';

const healthUrl = `${CHAT_APP_ORIGIN.replace(/\/$/, '')}/api/v1/health`;
const shortHealthUrl = healthUrl.replace(/^https?:\/\//, '');

const title = 'Status | Echo';
const description =
  'Live availability for Echo from the same health probe Echo’s Discord uptime monitor uses.';

const structuredData = pageStructuredData({
  title,
  description,
  path: '/status',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Status', path: '/status' },
  ],
});
---

<MarketingShell
  title={title}
  description={description}
  canonicalPath="/status"
  structuredData={structuredData}
>
  <main id="main" class="subpage-main">
    <section class="status-hero">
      <div class="container">
        <div class="status-hero-grid">
          <div class="status-hero-copy">
            <span class="hero-eyebrow">Systems</span>
            <h1>Echo status</h1>
            <p class="hero-lead">
              Live health for Echo—the same GET probe Echo’s Discord bot uses for{' '}
              <code class="status-code">e!cho uptime</code>, not a separate fleet dashboard.
            </p>
            <div class="status-hero-actions">
              <a class="btn-primary" href={CHAT_APP_ORIGIN}>Open Echo</a>
              <a class="btn-secondary" href="/support">Contact support</a>
            </div>
          </div>

          <div
            class="status-summary-card"
            id="status-summary"
            data-chat-origin={CHAT_APP_ORIGIN}
          >
            <div class="status-summary-glow" aria-hidden="true"></div>
            <div class="status-summary-top">
              <div class="status-summary-top-left">
                <span class="status-summary-label">Current status</span>
                <span class="status-live-badge" id="status-live-badge" data-state="connecting">
                  <span class="status-live-dot" aria-hidden="true"></span>
                  Live
                </span>
              </div>
              <time class="status-summary-time" id="status-last-checked">Starting…</time>
            </div>
            <div class="status-summary-body">
              <div class="status-orb-wrap" aria-hidden="true">
                <span class="status-orb-ring"></span>
                <span class="status-orb" id="status-orb" data-state="pending"></span>
              </div>
              <div class="status-summary-text">
                <p class="status-headline" id="status-headline" role="status" aria-live="polite">
                  Checking Echo…
                </p>
                <p class="status-subline" id="status-subline">
                  Probing {shortHealthUrl}.
                </p>
              </div>
            </div>
            <dl class="status-metrics">
              <div>
                <dt>Latency</dt>
                <dd id="status-latency">—</dd>
              </div>
              <div>
                <dt>Uptime (rolling 12)</dt>
                <dd id="status-rolling-uptime">—</dd>
              </div>
              <div>
                <dt>Uptime (this visit)</dt>
                <dd id="status-recorded-uptime">—</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="status-section">
      <div class="container">
        <div class="status-panel status-panel--chart">
          <header class="status-panel-head">
            <div>
              <h2>Health probe</h2>
              <p class="status-panel-lede">
                Each check is a GET to <code class="status-code">{shortHealthUrl}</code> with a 15s
                timeout—the same logic as the Discord uptime embed.
              </p>
            </div>
            <button type="button" class="btn-status-refresh" id="status-refresh" aria-label="Run check now">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12a9 9 0 11-3-7" stroke-linecap="round" />
                <path d="M21 3v6h-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Check now
            </button>
          </header>

          <div class="status-spark-wrap">
            <p class="status-spark-legend">
              <span><span class="status-dot status-dot--ok" aria-hidden="true"></span> faster</span>
              <span><span class="status-dot status-dot--bad" aria-hidden="true"></span> failed check</span>
            </p>
            <p
              id="status-sparkline"
              class="status-code status-sparkline"
              aria-label="Latency sparkline for the last twelve checks"
            >
              —
            </p>
          </div>

          <p id="status-latency-bar" class="status-code status-latency-bar">░░░░░░░░░░ —</p>
          <p id="status-error" class="status-probe-error" hidden></p>

          <dl class="status-metrics status-metrics--probe">
            <div>
              <dt>HTTP</dt>
              <dd id="status-http">—</dd>
            </div>
            <div>
              <dt>Endpoint</dt>
              <dd><code class="status-code" id="status-endpoint">{shortHealthUrl}</code></dd>
            </div>
          </dl>
        </div>

        <p class="status-page-footnote">
          This page polls every 30 seconds while open. The Echo bot’s scheduled uptime posts use the
          same endpoint with a longer interval (default 5 minutes). Rolling uptime covers the last 12
          checks; visit uptime resets when you reload.
        </p>
      </div>
    </section>
  </main>
</MarketingShell>

<script>
  import { bootStatusMonitor } from '../lib/statusMonitor';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => bootStatusMonitor(), { once: true });
  } else {
    bootStatusMonitor();
  }
</script>
