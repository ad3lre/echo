---
import MarketingShell from '../layouts/MarketingShell.astro';
import { pageStructuredData } from '../lib/seo';
import { CHAT_APP_ORIGIN } from '../site';

const title = 'Status | Echo';
const description =
  'Fleet-wide availability for chat-echo.com—the Echo web app, API, database, and real-time layer, with 90-day uptime history.';

const structuredData = pageStructuredData({
  title,
  description,
  path: '/status',
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Status', path: '/status' },
  ],
});
---

<MarketingShell
  title={title}
  description={description}
  canonicalPath="/status"
  structuredData={structuredData}
>
  <main id="main" class="subpage-main">
    <section class="status-hero">
      <div class="container">
        <div class="status-hero-grid">
          <div class="status-hero-copy">
            <span class="hero-eyebrow">Systems</span>
            <h1>Echo status</h1>
            <p class="hero-lead">
              Fleet-wide health for chat-echo.com—updated from Echo’s own monitoring, with 90-day uptime
              bars per component like Discord’s status page.
            </p>
            <div class="status-hero-actions">
              <a class="btn-primary" href={CHAT_APP_ORIGIN}>Open chat-echo.com</a>
              <a class="btn-secondary" href="/support">Contact support</a>
            </div>
          </div>

          <div
            class="status-summary-card"
            id="status-summary"
            data-chat-origin={CHAT_APP_ORIGIN}
          >
            <div class="status-summary-glow" aria-hidden="true"></div>
            <div class="status-summary-top">
              <div class="status-summary-top-left">
                <span class="status-summary-label">Current status</span>
                <span class="status-live-badge" id="status-live-badge" data-state="connecting">
                  <span class="status-live-dot" aria-hidden="true"></span>
                  Live
                </span>
              </div>
              <time class="status-summary-time" id="status-last-checked">Starting…</time>
            </div>
            <div class="status-summary-body">
              <div class="status-orb-wrap" aria-hidden="true">
                <span class="status-orb-ring"></span>
                <span class="status-orb" id="status-orb" data-state="pending"></span>
              </div>
              <div class="status-summary-text">
                <p class="status-headline" id="status-headline" role="status" aria-live="polite">
                  Loading fleet status…
                </p>
                <p class="status-subline" id="status-subline">
                  Fetching the latest snapshot from Echo monitoring.
                </p>
              </div>
            </div>
            <dl class="status-metrics">
              <div>
                <dt>Median latency</dt>
                <dd id="status-latency">—</dd>
              </div>
              <div>
                <dt>Fleet probe interval</dt>
                <dd id="status-probe-interval">—</dd>
              </div>
              <div>
                <dt>History window</dt>
                <dd id="status-history-label">90 days</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="status-section">
      <div class="container">
        <div class="status-panel">
          <header class="status-panel-head">
            <div>
              <h2>Services</h2>
              <p class="status-panel-lede">
                Monitored from Echo infrastructure every few minutes. Green bars are healthy days; yellow is
                degraded; red is an outage.
              </p>
            </div>
            <button type="button" class="btn-status-refresh" id="status-refresh" aria-label="Run check now">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12a9 9 0 11-3-7" stroke-linecap="round" />
                <path d="M21 3v6h-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Check now
            </button>
          </header>

          <ul class="status-service-list">
            <li class="status-service-block" id="status-row-web" data-state="pending">
              <div class="status-service-row">
                <div class="status-service-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3a14 14 0 009 9 14 14 0 00-9 9 14 14 0 00-9-9 14 14 0 009-9z" stroke-linecap="round" />
                  </svg>
                </div>
                <div class="status-service-main">
                  <div class="status-service-title">
                    <span class="status-service-name">Echo web app</span>
                    <span class="status-pill" id="status-pill-web" data-state="pending">Checking</span>
                  </div>
                  <p class="status-service-desc" id="status-desc-web">
                    Primary SPA and static assets—chat, voice, and community UI.
                  </p>
                </div>
                <div class="status-service-meta">
                  <span class="status-service-latency-label">Latency</span>
                  <span class="status-service-latency" id="status-latency-web">…</span>
                  <a class="status-service-link" href={CHAT_APP_ORIGIN} target="_blank" rel="noopener noreferrer">
                    chat-echo.com
                  </a>
                </div>
              </div>
              <div class="status-service-chart">
                <div class="status-spark status-spark--inline" id="status-spark-web" aria-label="Web app uptime history"></div>
                <p class="status-service-uptime" id="status-uptime-web"></p>
              </div>
            </li>

            <li class="status-service-block" id="status-row-api" data-state="pending">
              <div class="status-service-row">
                <div class="status-service-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 7h16M4 12h10M4 17h16" stroke-linecap="round" />
                  </svg>
                </div>
                <div class="status-service-main">
                  <div class="status-service-title">
                    <span class="status-service-name">Echo API</span>
                    <span class="status-pill" id="status-pill-api" data-state="pending">Checking</span>
                  </div>
                  <p class="status-service-desc" id="status-desc-api">
                    REST API for messages, auth, uploads, and server configuration.
                  </p>
                </div>
                <div class="status-service-meta">
                  <span class="status-service-latency-label">Latency</span>
                  <span class="status-service-latency" id="status-latency-api">…</span>
                  <a class="status-service-link" href={`${CHAT_APP_ORIGIN}/api/v1/health`} target="_blank" rel="noopener noreferrer">
                    /api/v1/health
                  </a>
                </div>
              </div>
              <div class="status-service-chart">
                <div class="status-spark status-spark--inline" id="status-spark-api" aria-label="API uptime history"></div>
                <p class="status-service-uptime" id="status-uptime-api"></p>
              </div>
            </li>

            <li class="status-service-block" id="status-row-database" data-state="pending">
              <div class="status-service-row">
                <div class="status-service-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="6" rx="8" ry="3" />
                    <path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" stroke-linecap="round" />
                  </svg>
                </div>
                <div class="status-service-main">
                  <div class="status-service-title">
                    <span class="status-service-name">Database</span>
                    <span class="status-pill" id="status-pill-database" data-state="pending">Checking</span>
                  </div>
                  <p class="status-service-desc" id="status-desc-database">
                    PostgreSQL backing Echo persistence.
                  </p>
                </div>
                <div class="status-service-meta">
                  <span class="status-service-latency-label">Latency</span>
                  <span class="status-service-latency" id="status-latency-database">…</span>
                </div>
              </div>
              <div class="status-service-chart">
                <div class="status-spark status-spark--inline" id="status-spark-database" aria-label="Database uptime history"></div>
                <p class="status-service-uptime" id="status-uptime-database"></p>
              </div>
            </li>

            <li class="status-service-block" id="status-row-realtime" data-state="pending">
              <div class="status-service-row">
                <div class="status-service-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M13 3L5 12h6l-1 9 9-12h-6l1-6z" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="status-service-main">
                  <div class="status-service-title">
                    <span class="status-service-name">Real-time messaging</span>
                    <span class="status-pill" id="status-pill-realtime" data-state="pending">Checking</span>
                  </div>
                  <p class="status-service-desc" id="status-desc-realtime">
                    NATS-backed fan-out for live updates across API nodes.
                  </p>
                </div>
                <div class="status-service-meta">
                  <span class="status-service-latency-label">Latency</span>
                  <span class="status-service-latency" id="status-latency-realtime">…</span>
                </div>
              </div>
              <div class="status-service-chart">
                <div class="status-spark status-spark--inline" id="status-spark-realtime" aria-label="Real-time uptime history"></div>
                <p class="status-service-uptime" id="status-uptime-realtime"></p>
              </div>
            </li>
          </ul>
        </div>

        <div class="status-panel">
          <header class="status-panel-head">
            <div>
              <h2>Incidents</h2>
              <p class="status-panel-lede">Planned and unplanned events that affect availability.</p>
            </div>
          </header>
          <div class="status-incidents-empty">
            <div class="status-incidents-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linejoin="round" />
                <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h3>No active incidents</h3>
            <p>
              When something impacts chat-echo.com, we will post details here. For urgent help, email{' '}
              <a href="mailto:support@app-echo.net">support@app-echo.net</a> or visit{' '}
              <a href="/support">Support</a>.
            </p>
          </div>
        </div>

        <p class="status-page-footnote">
          Uptime history reflects probes from Echo’s monitoring fleet, aggregated into UTC days. The page refreshes
          every 30 seconds; infrastructure probes run on a slower interval (shown above).
        </p>
      </div>
    </section>
  </main>
</MarketingShell>

<script>
  import { bootStatusMonitor } from '../lib/statusMonitor';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => bootStatusMonitor(), { once: true });
  } else {
    bootStatusMonitor();
  }
</script>
