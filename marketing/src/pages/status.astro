---
import MarketingShell from '../layouts/MarketingShell.astro';
import { CHAT_APP_ORIGIN } from '../site';

const title = 'Status | Echo';
const description =
  'Live availability for chat-echo.com—the Echo web app. See current status, recent checks from your browser, and incident updates.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: new URL('/status', Astro.site).toString(),
};
---

<MarketingShell
  title={title}
  description={description}
  canonicalPath="/status"
  structuredData={structuredData}
>
  <main id="main" class="subpage-main">
    <section class="status-hero">
      <div class="container">
        <div class="status-hero-grid">
          <div class="status-hero-copy">
            <span class="hero-eyebrow">Systems</span>
            <h1>Echo status</h1>
            <p class="hero-lead">
              Real-time reachability for the Echo web app at chat-echo.com. Checks run in your browser and may
              differ from what you see on a corporate network or VPN.
            </p>
            <div class="status-hero-actions">
              <a class="btn-primary" href={CHAT_APP_ORIGIN}>Open chat-echo.com</a>
              <a class="btn-secondary" href="/support">Contact support</a>
            </div>
          </div>

          <div
            class="status-summary-card"
            id="status-summary"
            data-chat-origin={CHAT_APP_ORIGIN}
            data-probe-path="/favicon.svg"
          >
            <div class="status-summary-glow" aria-hidden="true"></div>
            <div class="status-summary-top">
              <span class="status-summary-label">Current status</span>
              <time class="status-summary-time" id="status-last-checked">Checking…</time>
            </div>
            <div class="status-summary-body">
              <div class="status-orb-wrap" aria-hidden="true">
                <span class="status-orb-ring"></span>
                <span class="status-orb" id="status-orb" data-state="pending"></span>
              </div>
              <div class="status-summary-text">
                <p class="status-headline" id="status-headline" role="status" aria-live="polite">
                  Running a quick health check…
                </p>
                <p class="status-subline" id="status-subline">
                  Measuring latency to a lightweight asset on chat-echo.com.
                </p>
              </div>
            </div>
            <dl class="status-metrics">
              <div>
                <dt>Latency</dt>
                <dd id="status-latency">—</dd>
              </div>
              <div>
                <dt>Endpoint</dt>
                <dd><code class="status-code" id="status-endpoint">favicon.svg</code></dd>
              </div>
              <div>
                <dt>Checks on this device</dt>
                <dd id="status-rollups">—</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="status-section">
      <div class="container">
        <div class="status-panel">
          <header class="status-panel-head">
            <div>
              <h2>Services</h2>
              <p class="status-panel-lede">Core surfaces we monitor for availability.</p>
            </div>
            <button type="button" class="btn-status-refresh" id="status-refresh" aria-label="Run check again">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 12a9 9 0 11-3-7" stroke-linecap="round" />
                <path d="M21 3v6h-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Refresh
            </button>
          </header>

          <ul class="status-service-list">
            <li class="status-service-row" id="status-row-web">
              <div class="status-service-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M3 12h18M12 3a14 14 0 009 9 14 14 0 00-9 9 14 14 0 00-9-9 14 14 0 009-9z" stroke-linecap="round" />
                </svg>
              </div>
              <div class="status-service-main">
                <div class="status-service-title">
                  <span class="status-service-name">Echo web app</span>
                  <span class="status-pill" id="status-pill-web" data-state="pending">Checking</span>
                </div>
                <p class="status-service-desc">
                  Primary SPA and API host for Echo—chat, voice, and community features.
                </p>
              </div>
              <div class="status-service-meta">
                <a class="status-service-link" href={CHAT_APP_ORIGIN} target="_blank" rel="noopener noreferrer">
                  chat-echo.com
                </a>
              </div>
            </li>
          </ul>
        </div>

        <div class="status-panel status-panel--chart">
          <header class="status-panel-head">
            <div>
              <h2>Recent checks</h2>
              <p class="status-panel-lede">
                Each bar is one probe from <strong>this browser</strong>. Green is reachable; red is a timeout or
                network block. Grey is before we had data.
              </p>
            </div>
          </header>
          <div class="status-spark-wrap" aria-label="Recent check results">
            <div class="status-spark" id="status-spark"></div>
            <div class="status-spark-legend">
              <span><i class="status-dot status-dot--ok"></i> Up</span>
              <span><i class="status-dot status-dot--bad"></i> Issue</span>
              <span><i class="status-dot status-dot--pending"></i> Unknown</span>
            </div>
          </div>
          <p class="status-footnote" id="status-uptime-line"></p>
        </div>

        <div class="status-panel">
          <header class="status-panel-head">
            <div>
              <h2>Incidents</h2>
              <p class="status-panel-lede">Planned and unplanned events that affect availability.</p>
            </div>
          </header>
          <div class="status-incidents-empty">
            <div class="status-incidents-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linejoin="round" />
                <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h3>No active incidents</h3>
            <p>
              When something impacts chat-echo.com, we will post details here. For urgent help, email{' '}
              <a href="mailto:support@app-echo.net">support@app-echo.net</a> or visit{' '}
              <a href="/support">Support</a>.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</MarketingShell>

<script>
  const STORAGE_KEY = 'echo-marketing-status-checks-v1';
  const MAX_SAMPLES = 72;
  const PROBE_TIMEOUT_MS = 12000;

  type Sample = { t: number; ok: boolean; ms: number | null };

  function readSamples(): Sample[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw) as unknown;
      if (!Array.isArray(parsed)) return [];
      return parsed
        .filter(
          (x): x is Sample =>
            x &&
            typeof x === 'object' &&
            typeof (x as Sample).t === 'number' &&
            typeof (x as Sample).ok === 'boolean',
        )
        .map((x) => ({ t: x.t, ok: x.ok, ms: typeof x.ms === 'number' || x.ms === null ? x.ms : null }));
    } catch {
      return [];
    }
  }

  function writeSamples(samples: Sample[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(samples.slice(-MAX_SAMPLES)));
    } catch {
      /* quota or private mode */
    }
  }

  function pushSample(sample: Sample) {
    const next = [...readSamples(), sample].slice(-MAX_SAMPLES);
    writeSamples(next);
    return next;
  }

  function formatTime(iso: string) {
    try {
      const d = new Date(iso);
      return d.toLocaleString(undefined, {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    } catch {
      return iso;
    }
  }

  function setState(
    root: HTMLElement,
    state: 'operational' | 'degraded' | 'down' | 'pending',
    detail: { ms: number | null; headline: string; subline: string },
  ) {
    const orb = document.getElementById('status-orb');
    const headline = document.getElementById('status-headline');
    const subline = document.getElementById('status-subline');
    const pill = document.getElementById('status-pill-web');
    const latency = document.getElementById('status-latency');

    if (orb) orb.setAttribute('data-state', state);
    if (headline) headline.textContent = detail.headline;
    if (subline) subline.textContent = detail.subline;
    if (pill) {
      pill.setAttribute('data-state', state);
      pill.textContent =
        state === 'operational'
          ? 'Operational'
          : state === 'degraded'
            ? 'Degraded'
            : state === 'down'
              ? 'Unreachable'
              : 'Checking';
    }
    if (latency) {
      if (detail.ms != null && Number.isFinite(detail.ms)) latency.textContent = `${detail.ms} ms`;
      else latency.textContent = '—';
    }

    root.dataset.liveState = state;
  }

  function renderSpark(samples: Sample[]) {
    const el = document.getElementById('status-spark');
    const uptimeLine = document.getElementById('status-uptime-line');
    if (!el) return;

    const slots = MAX_SAMPLES;
    const data = samples.slice(-slots);
    const pad = slots - data.length;
    el.innerHTML = '';

    for (let i = 0; i < pad; i += 1) {
      const bar = document.createElement('span');
      bar.className = 'status-bar status-bar--pending';
      bar.title = 'No data yet';
      el.appendChild(bar);
    }

    for (const s of data) {
      const bar = document.createElement('span');
      bar.className = `status-bar ${s.ok ? 'status-bar--ok' : 'status-bar--bad'}`;
      const when = new Date(s.t).toLocaleString();
      const ms = s.ms != null ? `${s.ms} ms` : 'n/a';
      bar.title = `${when} — ${s.ok ? 'Reachable' : 'Issue'} (${ms})`;
      el.appendChild(bar);
    }

    if (uptimeLine) {
      const okCount = data.filter((s) => s.ok).length;
      const total = data.length;
      if (total === 0) {
        uptimeLine.textContent =
          'Visit again to build a history—each refresh records one check on this device.';
      } else {
        const pct = ((okCount / total) * 100).toFixed(1);
        uptimeLine.textContent = `Rolling reachability on this device: ${pct}% over the last ${total} recorded ${total === 1 ? 'check' : 'checks'}.`;
      }
    }
  }

  function probeImage(url: string): Promise<{ ok: boolean; ms: number | null }> {
    return new Promise((resolve) => {
      const img = new Image();
      const t0 = performance.now();
      let settled = false;

      const finish = (ok: boolean) => {
        if (settled) return;
        settled = true;
        const ms = Math.round(performance.now() - t0);
        resolve({ ok, ms: ok ? ms : null });
      };

      const timer = window.setTimeout(() => finish(false), PROBE_TIMEOUT_MS);
      img.onload = () => {
        window.clearTimeout(timer);
        finish(true);
      };
      img.onerror = () => {
        window.clearTimeout(timer);
        finish(false);
      };
      img.src = url;
    });
  }

  async function runCheck(root: HTMLElement, options?: { persist?: boolean }) {
    const persist = options?.persist !== false;
    const origin = root.dataset.chatOrigin ?? 'https://chat-echo.com';
    const path = root.dataset.probePath ?? '/favicon.svg';
    const endpoint = document.getElementById('status-endpoint');
    if (endpoint) endpoint.textContent = path.replace(/^\//, '') || path;

    setState(root, 'pending', {
      ms: null,
      headline: 'Running a quick health check…',
      subline: 'Measuring latency to a lightweight asset on chat-echo.com.',
    });

    const url = `${origin.replace(/\/$/, '')}${path}?t=${Date.now()}`;
    const { ok, ms } = await probeImage(url);

    const now = Date.now();
    const samples = persist
      ? pushSample({ t: now, ok, ms: ok ? ms : null })
      : readSamples();

    const roll = document.getElementById('status-rollups');
    const stored = readSamples();
    if (roll) roll.textContent = stored.length ? String(stored.length) : '—';

    const last = document.getElementById('status-last-checked');
    const iso = new Date(now).toISOString();
    if (last) {
      last.setAttribute('datetime', iso);
      last.textContent = `Updated ${formatTime(iso)}`;
    }

    if (ok) {
      const degraded = ms != null && ms > 2500;
      setState(root, degraded ? 'degraded' : 'operational', {
        ms,
        headline: degraded ? 'Reachable, but slow from here' : 'All systems operational',
        subline: degraded
          ? 'The app responded, but round-trip time is high—try a wired connection or disable VPN.'
          : 'chat-echo.com answered quickly. You should be able to load Echo normally.',
      });
    } else {
      setState(root, 'down', {
        ms: null,
        headline: 'We could not reach chat-echo.com',
        subline:
          'This may be a local network issue, DNS filtering, or a temporary outage. Try again in a minute.',
      });
    }

    renderSpark(persist ? samples : readSamples());
  }

  function boot() {
    const root = document.getElementById('status-summary');
    if (!(root instanceof HTMLElement)) return;

    renderSpark(readSamples());

    const roll = document.getElementById('status-rollups');
    const existing = readSamples().length;
    if (roll) roll.textContent = existing ? String(existing) : '—';

    void runCheck(root, { persist: true });

    const btn = document.getElementById('status-refresh');
    btn?.addEventListener('click', () => {
      void runCheck(root, { persist: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
