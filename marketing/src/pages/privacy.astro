---
import LegalMarkdownArticle from '../components/LegalMarkdownArticle.astro';
import privacyMd from '../../../terms/privacy.md?raw';

const title = 'Privacy Policy | Echo';
const description =
  'Learn how Echo collects, uses, stores, and shares your data—including Google and YouTube data when you use those features.';
const lastUpdated = '23 March 2026';
---

<LegalMarkdownArticle
  title={title}
  pageHeading="Privacy Policy"
  description={description}
  canonicalPath="/privacy"
  lastUpdated={lastUpdated}
  markdown={privacyMd}
  footerLinks={[
    { href: '/terms', label: 'Terms of Service' },
    { href: '/community-guidelines', label: 'Community Guidelines' },
    { href: '/attributions', label: 'Attributions' },
  ]}
/>
