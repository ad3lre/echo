{
  "name": "echo-discord-export-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Export Discord guild structure, permissions, members, and assets to JSON for platform import",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "export": "npm run build && node dist/index.js",
    "serve": "npm run build && node dist/index.js --serve",
    "serve:dev": "tsx src/index.ts --serve"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "discord.js": "^14.26.3",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
