{
  "name": "bot",
  "version": "1.0.0",
  "private": true,
  "description": "Export Discord guild structure, permissions, members, and assets to JSON for platform import",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "bun dist/index.js",
    "dev": "bun src/index.ts",
    "export": "bun run build && bun dist/index.js",
    "serve": "bun run build && bun dist/index.js --serve",
    "serve:dev": "bun src/index.ts --serve"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  }
}
