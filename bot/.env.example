# Discord bot token (Bot section in Developer Portal)
DISCORD_BOT_TOKEN=

# Default guild to export when not passed on the CLI (ignored when using --serve)
DISCORD_GUILD_ID=

# Base directory for export folders (default: ./exports relative to cwd)
EXPORT_BASE_DIR=

# Long-running mode: npm run serve:dev (or dist with --serve)
# On each new guild invite, writes an export bundle under EXPORT_BASE_DIR after a permission check.
# Optional CLI: --strict, --serve-bootstrap (with --serve), --strip-voice-bitrate
# See bot/EXPORT_CONTRACT.md
#
# Echo API (export-ready + Discord → Echo live bridge)
# ECHO_DISCORD_BOT_WEBHOOK_SECRET must match the API’s ECHO_DISCORD_BOT_WEBHOOK_SECRET.
# ECHO_API_BASE_URL = Echo API origin (e.g. https://api.example.com) so the bot can poll
# /api/v1/hooks/discord-bridge/allowlist and POST /api/v1/hooks/discord-bridge/inbound.
# If unset, derived from ECHO_DISCORD_BOT_WEBHOOK_URL or defaults to http://127.0.0.1:3000.
# ECHO_DISCORD_BRIDGE_POLL_MS — allowlist refresh interval (default 30000 ms).
ECHO_DISCORD_BOT_WEBHOOK_URL=
ECHO_DISCORD_BOT_WEBHOOK_SECRET=
ECHO_API_BASE_URL=
ECHO_DISCORD_BRIDGE_POLL_MS=
