#!/usr/bin/env bash
# 1) Block GitHub pushes that leak GitLab main history (github-push-guard.sh).
# 2) CI precheck before pushes to non-GitHub remotes (server/ops/scripts/ci-precheck.sh).
# 3) Mirror release/1.0.0 to GitHub only when ECHO_RELEASE_MIRROR_NOW=1; otherwise daily cron.
#
# See docs/operations/github-release-mirror.md.
set -euo pipefail

remote_name="${1:-}"
push_url="${2:-}"
zero=0000000000000000000000000000000000000000
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
MIRROR_HOUR="${ECHO_RELEASE_MIRROR_HOUR:-23}"
MIRROR_TZ="${ECHO_RELEASE_MIRROR_TZ:-Europe/Berlin}"
GUARD="$ROOT/server/ops/scripts/githooks/github-push-guard.sh"

ref_updates=$(cat || true)

if [[ ! -f "$GUARD" ]]; then
  echo "pre-push: missing $GUARD — run ./server/ops/scripts/setup-githooks.sh" >&2
  exit 1
fi
# shellcheck source=server/ops/scripts/githooks/github-push-guard.sh
source "$GUARD"

check_branch_upstream_policy "$ROOT"
github_push_guard "$remote_name" "$push_url" "$ref_updates" "$ROOT"

# --- CI precheck (GitLab / other remotes; skip GitHub mirror pushes) ---
if [[ -z "${ECHO_SKIP_CI_PRECHECK:-}" ]] && ! is_github_push_remote "$remote_name" "$push_url"; then
  has_branch_push=0
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    [[ "$local_sha" == "$zero" ]] && continue
    has_branch_push=1
    break
  done <<<"$ref_updates"
  if [[ "$has_branch_push" -eq 1 ]]; then
    echo "pre-push: running CI precheck (skip with ECHO_SKIP_CI_PRECHECK=1) …" >&2
    bash "$ROOT/server/ops/scripts/ci-precheck.sh"
  fi
fi

if is_github_push_remote "$remote_name" "$push_url"; then
  exit 0
fi

release_pushed=0
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$local_sha" == "$zero" ]]; then
    continue
  fi
  if [[ "$remote_ref" == "refs/heads/release/1.0.0" ]]; then
    release_pushed=1
  fi
done <<<"$ref_updates"

if [[ "$release_pushed" -eq 0 ]]; then
  exit 0
fi

if [[ -n "${ECHO_RELEASE_MIRROR_NOW:-}" ]]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    [[ "$local_sha" == "$zero" ]] && continue
    [[ "$remote_ref" != "refs/heads/release/1.0.0" ]] && continue
    bash "$ROOT/server/ops/scripts/mirror-release-to-github.sh" "$local_sha"
  done <<<"$ref_updates"
  exit 0
fi

printf 'pre-push: GitHub mirror deferred until %s:00 %s (batched once per day).\n' \
  "$MIRROR_HOUR" "$MIRROR_TZ" >&2
printf '  GitLab push will continue. To mirror immediately: ECHO_RELEASE_MIRROR_NOW=1 git push …\n' >&2
printf '  Or: npm run mirror:github-release\n' >&2
printf '  Install cron: npm run mirror:github-release:install-cron -- --yes\n' >&2
exit 0
