# Echo Backup Upload Environment
# 
# This file contains WRITE-ONLY credentials for the backup upload script.
# It is used by the echo-backup.service systemd unit.
#
# Security model:
#   - These credentials can ONLY write (PUT) objects - no read, list, or delete
#   - Store this file as /etc/echo/backup-upload.env with perms 640 (root:echo)
#   - Restore credentials go in a SEPARATE file: /etc/echo/backup-restore.env (root:root 600)
#
# Bucket lifecycle handles retention:
#   - postgres/daily/*   → expire after 7 days
#   - postgres/weekly/* → expire after 90 days (12+ weeks)

# Postgres connection (same as app DATABASE_URL)
DATABASE_URL=postgresql://echo:your_secure_password@localhost:5432/echo

# S3/R2 bucket for backups (different from ECHO_S3_* media bucket)
ECHO_BACKUP_S3_BUCKET=echo-backups
ECHO_BACKUP_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# Write-only API credentials (create these with Object Write only permission)
ECHO_BACKUP_S3_ACCESS_KEY=your_write_only_access_key_here
ECHO_BACKUP_S3_SECRET_KEY=your_write_only_secret_key_here

# Client-side AES-256-GCM encryption of the dump before upload (uploads <date>.dump.enc).
# Generate: openssl rand -hex 32   — store a copy OFFLINE; without it backups are unrecoverable.
# Decrypt: ECHO_BACKUP_ENCRYPTION_KEY=... bun server/ops/scripts/backup/pg-dump-decrypt.mjs in.dump.enc out.dump
# Keep the key only in the restore env (backup-restore.env) as well; never the same bucket creds.
# Required when NODE_ENV=production unless ECHO_BACKUP_ALLOW_PLAINTEXT=1 (not recommended).
# ECHO_BACKUP_ENCRYPTION_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32
# ECHO_BACKUP_ALLOW_PLAINTEXT=1

# Optional: prefix inside bucket (default: postgres)
# ECHO_BACKUP_S3_PREFIX=postgres

# Optional: temp directory for dump file (default: system temp dir)
# ECHO_BACKUP_TMP_DIR=/var/lib/echo/backups/tmp

# Bun path (set if not in default PATH)
# PATH=/home/echo/.bun/bin:/usr/local/bin:/usr/bin:/bin
