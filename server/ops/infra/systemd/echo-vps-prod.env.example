# Copy to /etc/echo/vps-prod.env (root:echo, mode 640) and fix paths for your host.
#
# PATH must include the Bun binary used for production builds (see .bun-version).
PATH=/home/founder/.bun/bin:/usr/bin:/bin

# Optional: override checkout path if not /home/founder/prod/echo
# ECHO_REPO_ROOT=/home/founder/prod/echo
