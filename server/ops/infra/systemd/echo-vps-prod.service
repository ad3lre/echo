# Production redeploy: preverify, build, and restart prod:serve (see docs/operations/linux-vps-deployment.md).
# Install: sudo ./server/ops/scripts/deploy/install-vps-prod-systemd.sh

[Unit]
Description=Echo production redeploy (npm run vps:prod)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=echo
Group=echo

# Optional: PATH for Node/npm (nvm), ECHO_REPO_ROOT override.
EnvironmentFile=-/etc/echo/vps-prod.env

WorkingDirectory=/home/founder/prod/echo

ExecStart=/usr/bin/env npm run vps:prod

TimeoutStartSec=3600
Nice=5

[Install]
WantedBy=multi-user.target
