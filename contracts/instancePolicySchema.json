                        "timeWindow": {
                          "type": "string",
                          "enum": ["1 minute", "15 minutes", "1 hour"]
                        }
                      }
                    },
                    "readStateWrite": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max": {
                          "type": "integer",
