    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "string",
              "minLength": 1
            },
            "available": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "optimal": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
