                        "timeWindow": {
                          "type": "string",
                          "enum": ["1 minute", "15 minutes", "1 hour"]
                        }
                      }
                    },
                    "forgotPassword": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max": {
                          "type": "integer",
                          "minimum": 0
