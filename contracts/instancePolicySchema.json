                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "register": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "timeWindow": {
                          "type": "string",
                          "enum": ["1 minute", "15 minutes", "1 hour"]
                        }
                      }
                    },
                    "login": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "timeWindow": {
                          "type": "string",
                          "enum": ["1 minute", "15 minutes", "1 hour"]
                        }
                      }
                    },
                    "loginStrict": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "max": {
                          "type": "integer",
                          "minimum": 0
