                        },
                        "timeWindow": {
                          "type": "string",
                          "enum": ["1 minute", "15 minutes", "1 hour"]
                        }
                      }
                    }
                  }
                }
              }
            },
            "absolute": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "register": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
