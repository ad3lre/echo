                  }
                },
                "messages": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "windowMs": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serper": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "perMinute": {
                  "type": "integer",
                  "minimum": 0
