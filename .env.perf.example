# Production perf baseline — environment template
# Copy to repo root: cp .env.perf.example .env.perf
# Never commit .env.perf (gitignored).

PERF_BASE_URL=https://chat-echo.com

# Dedicated perf fixture account on production (not a real user password in git)
PERF_TEST_USERNAME=
PERF_TEST_PASSWORD=

# Stable fixture IDs from the perf guild (see docs/operations/perf-baseline.md)
PERF_SERVER_ID=
PERF_CHANNEL_A=
PERF_CHANNEL_B=
PERF_VOICE_CHANNEL=

# Median/p95 are computed across this many iterations per scenario
PERF_ITERATIONS=5
