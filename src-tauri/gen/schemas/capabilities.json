    "platforms": ["linux", "macOS", "windows"]
  },
  "ios": {
    "identifier": "ios",
    "description": "Echo iOS WebView — desktop-only permissions omitted",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "deep-link:default",
      "dialog:allow-save",
      "notification:default",
