  "default": {
    "identifier": "default",
    "description": "Echo desktop main window",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:window:allow-close",
      "core:window:allow-minimize",
      "core:window:allow-start-dragging",
