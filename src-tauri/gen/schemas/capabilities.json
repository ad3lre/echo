{
  "android": {
    "identifier": "android",
    "description": "Echo Android WebView — desktop-only permissions omitted",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "deep-link:default",
      "dialog:allow-save",
      "notification:default",
      "opener:default",
      "process:default"
    ],
    "platforms": ["android"]
