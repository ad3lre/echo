<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Echo uses the microphone for voice and video in your servers.</string>
	<key>NSCameraUsageDescription</key>
	<string>Echo uses the camera for video chat and sharing images.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Echo needs access to your photo library to attach images and media to messages.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Echo uses the local network to reach your development machine when testing on a device.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
