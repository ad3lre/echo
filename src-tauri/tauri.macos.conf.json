{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Echo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dataDirectory": "main-webview",
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "shadow": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "targets": ["dmg"],
    "macOS": {
      "entitlements": "./Entitlements.macos.plist",
      "hardenedRuntime": true
    }
  }
}
